# ─────────────────────────────────────────────────────────────────────────────
# Hustle Studio — environment variables
#
# Copy this file to `.env` for local development and fill in the values.
# `.env` is ignored by Git: it never goes to GitHub.
# In production, set the same names in Vercel → Project → Settings →
# Environment Variables. All server-only: none of them reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

# E-mails via resend.com: contact form, newsletter, drop waitlist, pop-up
# sign-ups (see docs/WAITLIST.md). Without it, those forms answer
# "unavailable" and the pop-up stays hidden.
RESEND_API_KEY=
# Inbox that receives them (defaults to BRAND.email in app/config/brand.ts).
NOTIFICATION_EMAIL=
