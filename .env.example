# ─────────────────────────────────────────────────────────────────────────────
# Hustle Studio — environment variables
#
# Copy this file to `.env` for local development and fill in the values.
# `.env` is ignored by Git: it never goes to GitHub.
# In production, set the same names in Vercel → Project → Settings →
# Environment Variables. Step-by-step guide: docs/SHOPIFY-VERCEL.md
# ─────────────────────────────────────────────────────────────────────────────

# Required ────────────────────────────────────────────────────────────────────

# Your store's myshopify domain, e.g. hustle-studio.myshopify.com
# (NOT admin.shopify.com). Shopify Admin → Settings → Domains.
PUBLIC_STORE_DOMAIN=

# Storefront API public access token.
# Shopify Admin → Sales channels → Headless → your storefront → Storefront API.
PUBLIC_STOREFRONT_API_TOKEN=

# Storefront API private access token (same screen as above). Server-only.
PRIVATE_STOREFRONT_API_TOKEN=

# Any long random string, used to sign the session cookie. Server-only.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# Recommended ─────────────────────────────────────────────────────────────────

# Numeric storefront ID, for Shopify Analytics (Headless → your storefront).
PUBLIC_STOREFRONT_ID=

# Domain of the checkout, usually the same as PUBLIC_STORE_DOMAIN,
# or your custom domain if you have one (e.g. checkout.hustlestudio.fr).
PUBLIC_CHECKOUT_DOMAIN=

# Optional: customer accounts (/account) ──────────────────────────────────────
# Shopify Admin → Headless → your storefront → Customer Account API.
# Leave empty to hide the account icon and pages.
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
SHOP_ID=

# Optional: promotions & notifications ────────────────────────────────────────
# See docs/PROMOTIONS.md. All server-only, none of them reach the browser.

# Welcome pop-up (phone number → discount code): numbers are stored in Notion.
NOTION_API_KEY=
NOTION_PHONE_DATABASE_ID=

# E-mail copies of the review form and pop-up sign-ups (resend.com).
RESEND_API_KEY=
# Inbox that receives them (defaults to BRAND.email in app/config/brand.ts).
NOTIFICATION_EMAIL=
